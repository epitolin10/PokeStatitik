{% extends 'base.html.twig' %}

{% block title %}Usage Pokémon — PokeStatitik{% endblock %}

{% block body %}
    {% include 'partials/_header.html.twig' %}

    <main>
        <section class="usage-page container">
            <div class="section__header-row" style="margin-bottom: 24px;">
                <div>
                    <h1 class="section__title">Usage des Pokémons</h1>
                    <p class="section__subtitle">Tier des usages des Pokémons de la méta actuelle</p>
                </div>
                <div class="format-switch">
                    <a href="{{ path('app_usage', { pokemon: selected ? selected.slug : null, format: 'Doubles' }) }}" class="format-switch__option{{ format == 'Doubles' ? ' is-active' : '' }}">Champions Duo</a>
                    <a href="{{ path('app_usage', { pokemon: selected ? selected.slug : null, format: 'Singles' }) }}" class="format-switch__option{{ format == 'Singles' ? ' is-active' : '' }}">Champions Solo</a>
                </div>
            </div>

            <div class="usage-layout" data-controller="usage">
                <div class="usage-list" data-usage-target="list">
                    {% for pokemon in allPokemon %}
                        <a href="{{ path('app_usage', { pokemon: pokemon.slug, format: format }) }}"
                           class="usage-row{{ selected and selected.slug == pokemon.slug ? ' is-active' : '' }}"
                           data-action="click->usage#selectPokemon">
                            <span class="usage-row__badge">{{ pokemon.rang ?? pokemon.dexNumber ?? '?' }}</span>
                            <img class="usage-row__sprite" src="{{ champions_asset(pokemon.summary.sprite) }}" alt="{{ pokemon.name }}" loading="lazy">
                            <span class="usage-row__name">{{ pokemon_name_fr(pokemon.name, pokemon.showdownId) }}</span>
                            <span class="usage-row__types">
                                {% for type in pokemon.summary.types %}
                                    <img src="{{ asset(type_icon(type)) }}" alt="{{ type_name_fr(type) }}" title="{{ type_name_fr(type) }}">
                                {% endfor %}
                            </span>
                            <span class="usage-row__view-btn">Voir</span>
                        </a>
                    {% endfor %}
                </div>

                <div data-usage-target="detail">
                    {% include 'home/fragments/usage_detail.html.twig' %}
                </div>
            </div>
        </section>
    </main>

    {% include 'partials/_footer.html.twig' %}
{% endblock %}
