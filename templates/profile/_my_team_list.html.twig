{# Like _team_list.html.twig but with "Modifier / Supprimer" actions instead of a like button. Param: teams #}
<div class="recent-teams recent-teams--with-actions">
    <div class="recent-teams__head">
        <span>Pseudo :</span>
        <span>Pokémons :</span>
        <span>Titre :</span>
        <span>Tier :</span>
        <span>Favoris :</span>
        <span></span>
    </div>
    <div class="recent-teams__body">
        {% for team in teams %}
            <div class="recent-teams__row">
                <a href="{{ path('app_team_builder_published', { id: team.id }) }}" class="recent-teams__link">
                    <div class="recent-teams__user">
                        <div class="recent-teams__avatar">
                            {% if team.avatarFilename %}
                                <img src="{{ asset('uploads/avatars/' ~ team.avatarFilename) }}" alt="">
                            {% else %}
                                <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <circle cx="14" cy="10" r="5" fill="currentColor"/>
                                    <path d="M4 24C4 18.4772 8.47715 14 14 14C19.5228 14 24 18.4772 24 24" stroke="currentColor" stroke-width="2"/>
                                </svg>
                            {% endif %}
                        </div>
                        <span>{{ team.pseudo }}</span>
                    </div>
                    <div class="recent-teams__pokemons">
                        {% for pokemon in team.pokemons %}
                            <img src="{{ pokemon.sprite }}" alt="{{ pokemon.name }}">
                        {% endfor %}
                    </div>
                    <span>{{ team.titre }}</span>
                    <span class="recent-teams__tier">{{ team.tier }}</span>
                </a>
                <span class="recent-teams__favoris">{{ team.favoris }}</span>
                <div class="recent-teams__actions">
                    <a href="{{ path('app_team_builder_edit', { id: team.id }) }}" class="recent-teams__action-btn">Modifier</a>
                    <form method="post" action="{{ path('app_profile_team_delete', { id: team.id }) }}" onsubmit="return confirm('Supprimer définitivement « ' + {{ team.titre|json_encode }} + ' » ?');">
                        <button type="submit" class="recent-teams__action-btn recent-teams__action-btn--danger">Supprimer</button>
                    </form>
                </div>
            </div>
        {% else %}
            <p class="recent-teams__empty">Vous n'avez pas encore créé d'équipe — lancez-vous !</p>
        {% endfor %}
    </div>
</div>
