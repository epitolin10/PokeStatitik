<header class="site-header">
    <div class="container site-header__inner">
        <a href="{{ path('app_home') }}" class="brand">
            {% include 'partials/_logo.html.twig' with { class: 'brand__logo', uid: 'header' } %}
            <span class="brand__name">Poke<span>Statitik</span></span>
        </a>

        <nav class="site-nav">
            <a href="{{ path('app_usage') }}">Usage Pokémon</a>
            <a href="{{ path('app_teams') }}">Équipes</a>
            <a href="{{ path('app_calculator') }}">Calculateur de dégâts</a>
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_admin_classement') }}">Admin</a>
            {% endif %}
        </nav>

        <div class="header-actions">
            {% if app.user %}
                <div class="user-menu">
                    <a href="{{ path('app_profile') }}" class="user-menu__profile-link">
                        {% if app.user.avatarFilename %}
                            <img class="user-menu__avatar" src="{{ asset('uploads/avatars/' ~ app.user.avatarFilename) }}" alt="">
                        {% else %}
                            <span class="user-menu__avatar">{{ app.user.pseudo|slice(0, 1)|upper }}</span>
                        {% endif %}
                        <span class="user-menu__pseudo">{{ app.user.pseudo }}</span>
                    </a>
                    <a href="{{ path('app_logout') }}" class="user-menu__logout">Déconnexion</a>
                </div>
            {% else %}
                <a href="{{ path('app_login') }}" class="btn btn--primary">Connexion</a>
            {% endif %}
        </div>
    </div>
</header>
