<header class="site-header">
    <div class="container site-header__inner">
        <a href="{{ path('app_home') }}" class="brand">
            {% include 'partials/_logo.html.twig' with { class: 'brand__logo', uid: 'header' } %}
            <span class="brand__name">Poke<span>Statitik</span></span>
        </a>

        <nav class="site-nav">
            <a href="{{ path('app_usage') }}">Usage Pokémon</a>
            <a href="{{ path('app_teams') }}">Équipes</a>
            <a href="{{ path('app_calculator') }}">Calculateur de dégâts</a>
        </nav>

        <div class="header-actions">
            <form class="search-bar" role="search">
                <input type="search" name="q" placeholder="Rechercher un pokémon, objets, nature etc.">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="8" cy="8" r="6.5" stroke="white" stroke-width="1.5"/>
                    <path d="M17 17L13 13" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
            </form>
            {% if app.user %}
                <div class="user-menu">
                    <span class="user-menu__pseudo">{{ app.user.pseudo }}</span>
                    <a href="{{ path('app_logout') }}" class="user-menu__logout">Déconnexion</a>
                </div>
            {% else %}
                <a href="{{ path('app_login') }}" class="btn btn--primary">Connexion</a>
            {% endif %}
        </div>
    </div>
</header>
