{# Shared "Pseudo / Pokémons / Titre / Tier / Favoris" table. Param: teams #}
<div class="recent-teams">
    <div class="recent-teams__head">
        <span>Pseudo :</span>
        <span>Pokémons :</span>
        <span>Titre :</span>
        <span>Tier :</span>
        <span>Favoris :</span>
    </div>
    <div class="recent-teams__body">
        {% for team in teams %}
            <a href="{{ path('app_team_builder_published', { id: team.id }) }}" class="recent-teams__row">
                <div class="recent-teams__user">
                    <div class="recent-teams__avatar">
                        <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <circle cx="14" cy="10" r="5" fill="currentColor"/>
                            <path d="M4 24C4 18.4772 8.47715 14 14 14C19.5228 14 24 18.4772 24 24" stroke="currentColor" stroke-width="2"/>
                        </svg>
                    </div>
                    <span>{{ team.pseudo }}</span>
                </div>
                <div class="recent-teams__pokemons">
                    {% for pokemon in team.pokemons %}
                        <img src="{{ pokemon.sprite }}" alt="{{ pokemon.name }}">
                    {% endfor %}
                </div>
                <span>{{ team.titre }}</span>
                <span class="recent-teams__tier">{{ team.tier }}</span>
                <div class="recent-teams__favoris">
                    <svg width="20" height="18" viewBox="0 0 20 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M10 17S1 11.5 1 5.8C1 2.6 3.4 1 6 1c1.8 0 3.3 1 4 2.4C10.7 2 12.2 1 14 1c2.6 0 4.6 1.6 4.6 4.8C19 11.5 10 17 10 17Z" stroke="white" stroke-width="1.5"/>
                    </svg>
                    <span>{{ team.favoris }}</span>
                </div>
            </a>
        {% else %}
            <p class="recent-teams__empty">Aucune équipe partagée pour le moment — soyez le premier·ère à publier la vôtre !</p>
        {% endfor %}
    </div>
</div>
