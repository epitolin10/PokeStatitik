{% extends 'base.html.twig' %}

{% block title %}{{ equipe.titre }} — PokeStatitik{% endblock %}

{% block body %}
    {% include 'partials/_header.html.twig' %}

    <main>
        <section class="usage-page container" style="max-width: 1300px; margin: 0 auto;">
            {% for message in app.flashes('success') %}
                <p class="auth-error" style="background-color: rgba(57,255,136,0.12); border-color: var(--color-up); color: var(--color-up); max-width: none; text-align: center;">
                    {{ message }}
                </p>
            {% endfor %}

            <h1 class="section__title" style="text-align:center;">{{ equipe.titre }}</h1>
            {% if equipe.description %}<p class="section__subtitle" style="text-align:center;">{{ equipe.description }}</p>{% endif %}
            <p style="text-align:center; color: var(--color-text-muted); font-family: var(--font-body); margin-top: 8px;">Par {{ equipe.compte.pseudo }}</p>
            <p style="text-align:center; color: var(--color-primary-light); font-family: var(--font-title); margin-top: 4px;">{{ equipe.tiers.nomTiers }}</p>

            <div style="text-align:center; margin-top: 12px;">
                <form method="post" action="{{ path('app_team_like', { id: equipe.id }) }}" style="display: inline-block;">
                    <button type="submit" class="like-btn{{ hasLiked ? ' is-liked' }}"{{ app.user ? '' : ' disabled' }}>
                        <svg width="30" height="27" viewBox="0 0 20 18" xmlns="http://www.w3.org/2000/svg">
                            <path d="M10 17S1 11.5 1 5.8C1 2.6 3.4 1 6 1c1.8 0 3.3 1 4 2.4C10.7 2 12.2 1 14 1c2.6 0 4.6 1.6 4.6 4.8C19 11.5 10 17 10 17Z" fill="{{ hasLiked ? 'currentColor' : 'none' }}" stroke="currentColor" stroke-width="1.5"/>
                        </svg>
                        <span>{{ likeCount }}</span>
                    </button>
                </form>
            </div>

            <div class="team-detail-grid">
                {% for entry in slots %}
                    {% include 'team_builder/fragments/pokemon_summary_card.html.twig' with {
                        pokemon: entry.pokemon,
                        build: entry.build,
                        natures: natures,
                        moveTypes: entry.moveTypes,
                    } %}
                {% endfor %}
            </div>

            {% if app.user and app.user.id == equipe.compte.id %}
                <div style="text-align:center; margin-top: 32px;">
                    <a href="{{ path('app_team_builder') }}" class="btn btn--primary">Créer une autre équipe</a>
                </div>
            {% endif %}

            <div class="team-comments">
                <h2 class="team-comments__title">Commentaires</h2>

                {% if app.user %}
                    <form method="post" action="{{ path('app_team_comment', { id: equipe.id }) }}" class="team-comments__form">
                        <textarea name="commentaire" rows="3" placeholder="Laisser un commentaire..." required></textarea>
                        <button type="submit" class="btn btn--primary" style="align-self: flex-end;">Commenter</button>
                    </form>
                {% else %}
                    <p class="team-comments__login-hint"><a href="{{ path('app_login') }}">Connectez-vous</a> pour laisser un commentaire.</p>
                {% endif %}

                <div class="team-comments__list">
                    {% for comment in comments %}
                        <div class="team-comments__item">
                            <div class="team-comments__avatar">
                                <svg width="20" height="20" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <circle cx="14" cy="10" r="5" fill="currentColor"/>
                                    <path d="M4 24C4 18.4772 8.47715 14 14 14C19.5228 14 24 18.4772 24 24" stroke="currentColor" stroke-width="2"/>
                                </svg>
                            </div>
                            <div class="team-comments__body">
                                <strong>{{ comment.pseudo }}</strong>
                                <p>{{ comment.text }}</p>
                            </div>
                        </div>
                    {% else %}
                        <p class="team-comments__empty">Aucun commentaire pour le moment.</p>
                    {% endfor %}
                </div>
            </div>
        </section>
    </main>

    {% include 'partials/_footer.html.twig' %}
{% endblock %}
